---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { filterEntries, getGardenEntries, getGardenTags } from "../../lib/garden";
export async function getStaticPaths(){return (await getGardenTags()).map(({tag})=>({params:{tag},props:{tag}}));}
const { tag } = Astro.props; const entries = filterEntries(await getGardenEntries(), {tag});
---
<BaseLayout title={`标签：${tag}`} description={`浏览标签“${tag}”下的公开内容。`}><header class="page-head"><div><p class="kicker">标签内容 / 04</p><h1>#{tag}</h1></div><div><p>共 {entries.length} 条记录。标签会跨越文章、笔记和资源。</p></div></header><section>{entries.map((entry,index)=><EntryCard entry={entry} index={index}/>)}</section></BaseLayout>
