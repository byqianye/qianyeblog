---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getAllPosts, getAllTags } from "../../lib/content";
import homeContent from "../../data/home.json";

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const posts = (await getAllPosts()).filter((post) => post.data.tags.includes(tag));
const replaceTemplate = (template: string, values: Record<string, string | number>) =>
  Object.entries(values).reduce((text, [key, value]) => text.replaceAll(`{${key}}`, String(value)), template);
const tagPage = {
  title: `${homeContent.tagDetailTitlePrefix ?? "标签："}${tag}`,
  description: replaceTemplate(homeContent.tagDetailDescriptionTemplate ?? "浏览标签「{tag}」下的文章。", { tag }),
  eyebrow: homeContent.tagDetailEyebrow ?? "Tagged",
  countText: replaceTemplate(homeContent.tagDetailCountTemplate ?? "这个标签下共有 {count} 篇文字。", { count: posts.length }),
  listAriaLabel: replaceTemplate(homeContent.tagDetailListAriaTemplate ?? "标签 {tag} 的文章", { tag })
};
---

<BaseLayout title={tagPage.title} description={tagPage.description}>
  <section class="page-intro">
    <p class="eyebrow">{tagPage.eyebrow}</p>
    <h1>{tag}</h1>
    <p>{tagPage.countText}</p>
  </section>

  <section class="archive-list" aria-label={tagPage.listAriaLabel}>
    {
      posts.map((post) => (
        <ArticleCard
          href={`/blog/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          cover={post.data.cover}
          body={post.body}
        />
      ))
    }
  </section>
</BaseLayout>
