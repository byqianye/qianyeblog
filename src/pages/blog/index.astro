---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getAllPosts } from "../../lib/content";
import homeContent from "../../data/home.json";

const posts = await getAllPosts();
const blogPage = {
  title: homeContent.blogPageTitle ?? "文章",
  description: homeContent.blogPageDescription ?? "所有生活随笔、阅读记录和城市散步。",
  eyebrow: homeContent.blogPageEyebrow ?? "Archive",
  heading: homeContent.blogPageHeading ?? "文章",
  intro: homeContent.blogPageIntro ?? "按时间收纳所有公开文字。它们不急着回答什么，只是把生活里值得停顿的片刻留住。",
  listAriaLabel: homeContent.blogListAriaLabel ?? "文章列表"
};
---

<BaseLayout title={blogPage.title} description={blogPage.description}>
  <section class="page-intro">
    <p class="eyebrow">{blogPage.eyebrow}</p>
    <h1>{blogPage.heading}</h1>
    <p>{blogPage.intro}</p>
  </section>

  <section class="archive-list" aria-label={blogPage.listAriaLabel}>
    {
      posts.length > 0 ? posts.map((post) => (
        <ArticleCard
          href={`/blog/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          category={post.data.category}
          cover={post.data.cover}
          coverWidth={post.data.coverWidth}
          coverHeight={post.data.coverHeight}
          body={post.body}
        />
      )) : <EmptyState title="还没有文章" description="第一篇文章发布后会出现在这里。" />
    }
  </section>
</BaseLayout>
