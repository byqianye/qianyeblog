---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { formatDate, getAllPosts, getReadingMinutes, getRelatedPosts } from "../../lib/content";
import homeContent from "../../data/home.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedPosts = getRelatedPosts(post, await getAllPosts());
const readingTemplate = homeContent.readingMinutesTemplate ?? "{minutes} 分钟读完";
const tagAriaLabel = homeContent.articleTagsAriaLabel ?? "文章标签";
const tocHeadings = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-page">
    <header class="post-hero">
      <div>
        <div class="article-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>{post.data.category}</span>
          <span>{getReadingMinutes(post.body, readingTemplate)}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="tag-row" aria-label={tagAriaLabel}>
          {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>)}
        </div>
      </div>
      <img src={post.data.cover} alt="" />
    </header>
    <div class="post-body-grid">
      {
        tocHeadings.length > 0 && (
          <aside class="post-toc" aria-label="文章目录">
            <p>目录</p>
            <nav>
              {tocHeadings.map((heading) => (
                <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>
    {
      relatedPosts.length > 0 && (
        <section class="related-posts" aria-label="相关文章">
          <div class="section-heading">
            <p class="eyebrow">Related</p>
            <h2>相关文章</h2>
          </div>
          <div class="related-grid">
            {relatedPosts.map((related) => (
              <ArticleCard
                href={`/blog/${related.id}`}
                title={related.data.title}
                description={related.data.description}
                pubDate={related.data.pubDate}
                tags={related.data.tags}
                cover={related.data.cover}
                body={related.body}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
