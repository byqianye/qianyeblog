---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getAllPosts, formatDate } from "../lib/content";
import { siteConfig } from "../site.config";
import homeContent from "../data/home.json";

const posts = await getAllPosts();
const featured = posts[0];
const recent = posts.slice(1, 3);
const shareLabels = {
  featuredEyebrow: homeContent.featuredEyebrow ?? "精选分享",
  featuredTitle: homeContent.featuredTitle ?? "最近分享",
  recentEyebrow: homeContent.recentEyebrow ?? "近来",
  recentTitle: homeContent.recentTitle ?? "一些小分享",
  allSharesLabel: homeContent.allSharesLabel ?? "全部分享",
  publicSharesLabel: homeContent.publicSharesLabel ?? "篇公开分享",
  rssShareLabel: homeContent.rssShareLabel ?? "订阅这个慢慢分享的地方",
  journalStripAriaLabel: homeContent.journalStripAriaLabel ?? "站点信息",
  recentUpdateLabel: homeContent.recentUpdateLabel ?? "最近更新",
  emptyLatestLabel: homeContent.emptyLatestLabel ?? "即将开始",
  heroNoteAriaLabel: homeContent.heroNoteAriaLabel ?? "作者分享",
  quoteLoadingTitle: homeContent.quoteLoadingTitle ?? "正在取一句话",
  quoteLoadingDescription: homeContent.quoteLoadingDescription ?? "正在取一句诗",
  quoteLoadingSource: homeContent.quoteLoadingSource ?? "正在加载一言和诗句。",
  quoteFallbackSource: homeContent.quoteFallbackSource ?? "API 暂时不可用，已显示本地默认文字。"
};
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section
    class="hero quotes-loading"
    data-hitokoto-api={homeContent.hitokotoApi}
    data-poem-api={homeContent.poemApi}
  >
    <div class="hero-copy">
      <p class="eyebrow">{homeContent.eyebrow}</p>
      <h1 id="hero-title" class="quote-placeholder" data-fallback={homeContent.title} aria-busy="true">
        <span aria-hidden="true">{shareLabels.quoteLoadingTitle}</span>
      </h1>
      <p class="hero-description quote-placeholder" id="hero-description" data-fallback={homeContent.description} aria-busy="true">
        <span aria-hidden="true">{shareLabels.quoteLoadingDescription}</span>
      </p>
      <p class="hero-source sr-only" id="hero-source" aria-live="polite" data-fallback-source={shareLabels.quoteFallbackSource}>
        {shareLabels.quoteLoadingSource}
      </p>
      <div class="hero-actions">
        <a class="button primary" href={homeContent.primaryActionHref}>{homeContent.primaryActionLabel}</a>
        <a class="button quiet" href={homeContent.secondaryActionHref}>{homeContent.secondaryActionLabel}</a>
      </div>
    </div>
    <div class="hero-panel">
      <img src={homeContent.image} alt={homeContent.imageAlt} />
      <aside class="hero-note" aria-label={shareLabels.heroNoteAriaLabel}>
        <span>{homeContent.noteLabel}</span>
        <p>{homeContent.note}</p>
      </aside>
    </div>
  </section>

  <script>
    const hero = document.querySelector(".hero");
    const title = document.querySelector("#hero-title");
    const description = document.querySelector("#hero-description");
    const source = document.querySelector("#hero-source");

    const HERO_QUOTE_CACHE_KEY = "slow-journal.hero-quotes.v1";
    const pickText = (...values) => values.find((value) => typeof value === "string" && value.trim())?.trim();

    function normalizeQuote(value) {
      return String(value || "")
        .replace(/\s+/g, " ")
        .replace(/^["“”'‘’《》]+|["“”'‘’《》]+$/g, "")
        .trim();
    }

    function isGoodHitokoto(value) {
      const text = normalizeQuote(value);
      const looksLikeName = /^[\u4e00-\u9fffA-Za-z·]{2,8}[。.!?！？]?$/.test(text);

      return Boolean(text) && !looksLikeName;
    }

    async function fetchHitokotoCandidate(url, attempts = 6) {
      for (let index = 0; index < attempts; index += 1) {
        try {
          const data = await fetchJson(url);
          const candidate = normalizeQuote(pickText(data.hitokoto, data.sentence, data.content));
          if (isGoodHitokoto(candidate)) return candidate;
        } catch {
          // Try the next request before falling back to local copy.
        }
      }
      return "";
    }

    function readHeroQuoteCache() {
      try {
        const cache = JSON.parse(window.localStorage.getItem(HERO_QUOTE_CACHE_KEY) || "{}");
        return cache && typeof cache === "object" ? cache : {};
      } catch {
        return {};
      }
    }

    function writeHeroQuoteCache(nextCache) {
      try {
        const cache = { ...readHeroQuoteCache(), ...nextCache, updatedAt: Date.now() };
        window.localStorage.setItem(HERO_QUOTE_CACHE_KEY, JSON.stringify(cache));
      } catch {
        // localStorage can be disabled; the live API text can still render.
      }
    }

    function applyLengthClass(element, prefix) {
      const textLength = Array.from(element.textContent || "").length;
      const size =
        textLength > 42 ? "long" :
        textLength > 24 ? "medium" :
        "short";
      element.classList.remove(`${prefix}-short`, `${prefix}-medium`, `${prefix}-long`);
      element.classList.add(`${prefix}-${size}`);
    }

    async function fetchJson(url, timeout = 5200) {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), timeout);
      try {
        const response = await fetch(url, { signal: controller.signal, cache: "no-store" });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return await response.json();
      } finally {
        window.clearTimeout(timer);
      }
    }

    function parsePoem(data) {
      const poem = pickText(data.content, data.sentence, data.data?.content, data.result?.content);
      const author = pickText(data.author, data.origin?.author, data.data?.origin?.author, data.result?.author);
      const origin = pickText(data.origin, data.origin?.title, data.data?.origin?.title, data.result?.origin);
      const cite = [author, origin ? `《${origin}》` : ""].filter(Boolean).join(" ");
      return poem ? `${poem}${cite ? ` —— ${cite}` : ""}` : "";
    }

    function revealHeroQuotes(statusText) {
      title.removeAttribute("aria-busy");
      description.removeAttribute("aria-busy");
      title.classList.remove("quote-placeholder");
      description.classList.remove("quote-placeholder");
      applyLengthClass(title, "quote-title");
      applyLengthClass(description, "quote-desc");
      source.textContent = statusText;
      hero.classList.remove("quotes-loading");
      hero.classList.add("quotes-ready");
    }

    async function hydrateHeroQuotes() {
      if (!hero || !title || !description || !source) return;
      const fallbackTitle = title.dataset.fallback || "";
      const fallbackDescription = description.dataset.fallback || "";
      const hitokotoApi = hero.dataset.hitokotoApi;
      const poemApi = hero.dataset.poemApi;
      const cache = readHeroQuoteCache();
      const hasCachedText = Boolean(cache.title || cache.description);

      title.textContent = cache.title || fallbackTitle;
      description.textContent = cache.description || fallbackDescription;
      revealHeroQuotes(hasCachedText ? "已显示缓存文字。" : "已显示本地文字。");

      const [hitokotoResult, poemResult] = await Promise.allSettled([
        hitokotoApi ? fetchHitokotoCandidate(hitokotoApi) : Promise.reject(),
        poemApi ? fetchJson(poemApi) : Promise.reject()
      ]);

      const nextCache = {};
      let updated = false;

      if (hitokotoResult.status === "fulfilled" && hitokotoResult.value) {
        nextCache.title = hitokotoResult.value;
        updated = true;
      }

      if (poemResult.status === "fulfilled") {
        const poemText = parsePoem(poemResult.value);
        if (poemText) {
          nextCache.description = poemText;
          updated = true;
        }
      }

      if (updated) {
        writeHeroQuoteCache(nextCache);
      } else {
        source.textContent = hasCachedText ? "API 暂时不可用，已显示缓存文字。" : "API 暂时不可用，已显示本地默认文字。";
      }
    }

    hydrateHeroQuotes().catch(() => {
      if (title) {
        title.textContent = title.dataset.fallback || "";
        title.removeAttribute("aria-busy");
        title.classList.remove("quote-placeholder");
        applyLengthClass(title, "quote-title");
      }
      if (description) {
        description.textContent = description.dataset.fallback || "";
        description.removeAttribute("aria-busy");
        description.classList.remove("quote-placeholder");
        applyLengthClass(description, "quote-desc");
      }
      if (source) source.textContent = source.dataset.fallbackSource || "API 暂时不可用，已显示本地默认文字。";
      hero?.classList.remove("quotes-loading");
      hero?.classList.add("quotes-ready");
    });
  </script>

  {
    featured && (
      <section class="section-block">
        <div class="section-heading">
          <p class="eyebrow">{shareLabels.featuredEyebrow}</p>
          <h2>{shareLabels.featuredTitle}</h2>
        </div>
        <ArticleCard
          href={`/blog/${featured.id}`}
          title={featured.data.title}
          description={featured.data.description}
          pubDate={featured.data.pubDate}
          tags={featured.data.tags}
          cover={featured.data.cover}
          body={featured.body}
          featured
        />
      </section>
    )
  }

  <section class="section-block">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">{shareLabels.recentEyebrow}</p>
        <h2>{shareLabels.recentTitle}</h2>
      </div>
      <a href="/blog">{shareLabels.allSharesLabel}</a>
    </div>
    <div class="recent-grid">
      {
        recent.map((post) => (
          <ArticleCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover}
            body={post.body}
          />
        ))
      }
    </div>
  </section>

  <section class="journal-strip" aria-label={shareLabels.journalStripAriaLabel}>
    <div>
      <span>{posts.length}</span>
      <p>{shareLabels.publicSharesLabel}</p>
    </div>
    <div>
      <span>{posts[0] ? formatDate(posts[0].data.pubDate) : shareLabels.emptyLatestLabel}</span>
      <p>{shareLabels.recentUpdateLabel}</p>
    </div>
    <div>
      <span>RSS</span>
      <p><a href="/rss.xml">{shareLabels.rssShareLabel}</a></p>
    </div>
  </section>
</BaseLayout>
