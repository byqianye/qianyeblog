---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryCard from "../components/EntryCard.astro";
import { getGardenEntries, getGardenTags, kindLabels, type GardenKind } from "../lib/garden";
import home from "../data/home.json";
const entries = await getGardenEntries();
const tags = await getGardenTags();
const featured = entries.find((entry) => entry.data.featured) ?? entries[0];
const recent = entries.filter((entry) => entry.id !== featured?.id).slice(0, 4);
const kinds = Object.entries(kindLabels) as [GardenKind, string][];
---
<BaseLayout>
  <section class="home-hero">
    <div class="hero-number" aria-hidden="true">01</div>
    <div class="hero-copy"><p class="kicker">{home.kicker}</p><h1>{home.title}</h1></div>
    <div class="hero-note"><p>{home.description}</p><a href="/blog">进入花园 →</a></div>
  </section>
  {featured && <><div class="section-label"><span>精选内容</span><span>01</span></div><EntryCard entry={featured} variant="featured" /></>}
  <div class="section-label"><span>最近整理</span><a href="/archive">查看归档 →</a></div>
  <section>{recent.map((entry, index) => <EntryCard entry={entry} index={index + 1} />)}</section>
  <section class="home-index">
    <div><p class="kicker">内容类型</p><h2>三种尺度，<br />同一座花园。</h2></div>
    <div class="kind-links">{kinds.map(([kind,label],index) => <a href={`/blog?kind=${kind}`}><b>0{index+1}</b><span>{label}</span><small>{entries.filter((entry) => entry.data.kind === kind).length} 条</small></a>)}</div>
  </section>
  <section class="tag-index"><p class="kicker">主题标签</p><div>{tags.map(({tag,count}) => <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}<sup>{count}</sup></a>)}</div></section>
</BaseLayout>
<style>
  .home-hero{display:grid;grid-template-columns:1fr 2fr 1fr;min-height:620px;border-bottom:1px solid var(--line)}.home-hero>div{padding:1.5rem}.hero-number{font-size:clamp(7rem,18vw,17rem);font-weight:800;line-height:.75;letter-spacing:-.1em;color:var(--accent);overflow:hidden}.hero-copy{border-left:1px solid var(--line);display:flex;flex-direction:column;justify-content:center}.hero-copy h1{margin:0;max-width:13ch;font-size:clamp(3rem,6vw,6.5rem);line-height:.95;letter-spacing:-.065em}.hero-note{border-left:1px solid var(--line);display:flex;flex-direction:column;justify-content:flex-end;gap:2rem}.hero-note p{font-size:1.1rem}.hero-note a{font-weight:700}.home-index{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.home-index>div{padding:4rem 1.5rem}.home-index>div+div{border-left:1px solid var(--line)}.home-index h2{font-size:clamp(2.5rem,5vw,5.5rem);line-height:.92;letter-spacing:-.06em}.kind-links a{display:grid;grid-template-columns:3rem 1fr auto;gap:1rem;padding:1.2rem 0;border-top:1px solid var(--line);text-decoration:none}.kind-links b{color:var(--accent)}.kind-links small{color:var(--muted)}.tag-index{padding:4rem 1.5rem;border-top:1px solid var(--line)}.tag-index>div{display:flex;flex-wrap:wrap;gap:.25rem 1.2rem}.tag-index a{font-size:clamp(1.4rem,3vw,3.5rem);font-weight:700;letter-spacing:-.04em;text-decoration:none}.tag-index sup{margin-left:.25rem;color:var(--accent);font-size:.65rem}
  @media(max-width:800px){.home-hero{grid-template-columns:1fr 1fr;min-height:520px}.hero-number{font-size:7rem}.hero-copy{border-left:1px solid var(--line)}.hero-copy h1{font-size:2.7rem}.hero-note{grid-column:1/-1;border-left:0;border-top:1px solid var(--line);padding:1rem}.home-index{grid-template-columns:1fr}.home-index>div{padding:2.5rem 1rem}.home-index>div+div{border-left:0;border-top:1px solid var(--line)}}
</style>
