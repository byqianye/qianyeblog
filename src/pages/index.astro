---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getAllPosts, formatDate } from "../lib/content";
import { siteConfig } from "../site.config";
import homeContent from "../data/home.json";
import quotes from "../data/quotes.json";

const posts = await getAllPosts();
const featured = posts[0];
const recent = posts.slice(1, 3);
const heroQuoteFallback = quotes[0] ?? {
  title: homeContent.title,
  description: homeContent.description
};
const shareLabels = {
  featuredEyebrow: homeContent.featuredEyebrow ?? "精选分享",
  featuredTitle: homeContent.featuredTitle ?? "最近分享",
  recentEyebrow: homeContent.recentEyebrow ?? "近来",
  recentTitle: homeContent.recentTitle ?? "一些小分享",
  allSharesLabel: homeContent.allSharesLabel ?? "全部分享",
  publicSharesLabel: homeContent.publicSharesLabel ?? "篇公开分享",
  rssShareLabel: homeContent.rssShareLabel ?? "订阅这个慢慢分享的地方",
  journalStripAriaLabel: homeContent.journalStripAriaLabel ?? "站点信息",
  recentUpdateLabel: homeContent.recentUpdateLabel ?? "最近更新",
  emptyLatestLabel: homeContent.emptyLatestLabel ?? "即将开始",
  heroNoteAriaLabel: homeContent.heroNoteAriaLabel ?? "作者分享"
};
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="hero quotes-ready">
    <div class="hero-copy">
      <p class="eyebrow">{homeContent.eyebrow}</p>
      <h1 id="hero-title">{heroQuoteFallback.title}</h1>
      <p class="hero-description" id="hero-description">{heroQuoteFallback.description}</p>
      <div class="hero-actions">
        <a class="button primary" href={homeContent.primaryActionHref}>{homeContent.primaryActionLabel}</a>
        <a class="button quiet" href={homeContent.secondaryActionHref}>{homeContent.secondaryActionLabel}</a>
      </div>
    </div>
    <div class="hero-panel">
      <img src={homeContent.image} alt={homeContent.imageAlt} />
      <aside class="hero-note" aria-label={shareLabels.heroNoteAriaLabel}>
        <span>{homeContent.noteLabel}</span>
        <p>{homeContent.note}</p>
      </aside>
    </div>
  </section>

  <script id="hero-quotes" type="application/json" set:html={JSON.stringify(quotes)}></script>
  <script is:inline data-astro-rerun>
    (() => {
      const title = document.querySelector("#hero-title");
      const description = document.querySelector("#hero-description");
      const data = document.querySelector("#hero-quotes");
      if (!title || !description || !data) return;

      function applyLengthClass(element, prefix) {
        const textLength = Array.from(element.textContent || "").length;
        const size = textLength > 42 ? "long" : textLength > 24 ? "medium" : "short";
        element.classList.remove(`${prefix}-short`, `${prefix}-medium`, `${prefix}-long`);
        element.classList.add(`${prefix}-${size}`);
      }

      try {
        const quotes = JSON.parse(data.textContent || "[]").filter((item) => item?.title && item?.description);
        const quote = quotes[Math.floor(Math.random() * quotes.length)];
        if (quote) {
          title.textContent = quote.title;
          description.textContent = quote.description;
        }
      } catch {
        // The static fallback already renders above.
      }

      applyLengthClass(title, "quote-title");
      applyLengthClass(description, "quote-desc");
    })();
  </script>

  {
    featured && (
      <section class="section-block">
        <div class="section-heading">
          <p class="eyebrow">{shareLabels.featuredEyebrow}</p>
          <h2>{shareLabels.featuredTitle}</h2>
        </div>
        <ArticleCard
          href={`/blog/${featured.id}`}
          title={featured.data.title}
          description={featured.data.description}
          pubDate={featured.data.pubDate}
          tags={featured.data.tags}
          category={featured.data.category}
          cover={featured.data.cover}
          body={featured.body}
          featured
        />
      </section>
    )
  }

  <section class="section-block">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">{shareLabels.recentEyebrow}</p>
        <h2>{shareLabels.recentTitle}</h2>
      </div>
      <a href="/blog">{shareLabels.allSharesLabel}</a>
    </div>
    <div class="recent-grid">
      {
        recent.map((post) => (
          <ArticleCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            category={post.data.category}
            cover={post.data.cover}
            body={post.body}
          />
        ))
      }
    </div>
  </section>

  <section class="journal-strip" aria-label={shareLabels.journalStripAriaLabel}>
    <div>
      <span>{posts.length}</span>
      <p>{shareLabels.publicSharesLabel}</p>
    </div>
    <div>
      <span>{posts[0] ? formatDate(posts[0].data.pubDate) : shareLabels.emptyLatestLabel}</span>
      <p>{shareLabels.recentUpdateLabel}</p>
    </div>
    <div>
      <span>RSS</span>
      <p><a href="/rss.xml">{shareLabels.rssShareLabel}</a></p>
    </div>
  </section>
</BaseLayout>
