---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../site.config";
import homeContent from "../data/home.json";

const aboutPage = {
  title: homeContent.aboutPageTitle ?? "关于",
  description: homeContent.aboutPageDescription ?? "关于作者与这个博客。",
  eyebrow: homeContent.aboutEyebrow ?? "About",
  intro:
    homeContent.aboutIntro ??
    "这是一个暂时使用中性笔名的个人博客。它适合放生活札记、阅读摘抄、城市漫游和那些没有被社交媒体吞掉的长一点的想法。",
  sectionOneTitle: homeContent.aboutSectionOneTitle ?? "这里会写什么",
  sectionOneBody:
    homeContent.aboutSectionOneBody ??
    "写普通日子里的观察，也写读书、观影、散步和季节更替。文章不追逐热点，只保留慢一点的判断和更耐读的情绪。",
  sectionTwoTitle: homeContent.aboutSectionTwoTitle ?? "如何替换成你的资料",
  sectionTwoBody:
    homeContent.aboutSectionTwoBody ??
    "修改后台里的站点设置可以更换站点名、作者名、简介、联系方式和页面文案；在文章管理里新增文章即可发布内容。",
  buttonLabel: homeContent.aboutButtonLabel ?? "写封邮件"
};
---

<BaseLayout title={aboutPage.title} description={aboutPage.description}>
  <section class="about-layout">
    <div class="page-intro">
      <p class="eyebrow">{aboutPage.eyebrow}</p>
      <h1>{siteConfig.author}</h1>
      <p>{aboutPage.intro}</p>
    </div>

    <div class="about-note">
      <h2>{aboutPage.sectionOneTitle}</h2>
      <p>{aboutPage.sectionOneBody}</p>
      <h2>{aboutPage.sectionTwoTitle}</h2>
      <p>{aboutPage.sectionTwoBody}</p>
      <a class="button primary" href={`mailto:${siteConfig.email}`}>{aboutPage.buttonLabel}</a>
    </div>
  </section>
</BaseLayout>
