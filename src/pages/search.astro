---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="搜索" description="搜索浅靥数字花园中的标题、摘要、标签和正文。"><header class="page-head"><div><p class="kicker">站内搜索 / 05</p><h1>搜索</h1></div><div><p>输入标题、标签或正文中的关键词。搜索只在浏览器本地完成，不会上传查询内容。</p></div></header><section class="search-box"><label for="search">关键词</label><input id="search" type="search" autocomplete="off" placeholder="例如：工具、浏览器、影视"/><p class="status" aria-live="polite">正在载入索引…</p></section><section class="results"></section>
<script is:inline>
const input=document.querySelector('#search'),status=document.querySelector('.status'),results=document.querySelector('.results');let entries=[];const kindLabels={article:'文章',note:'笔记',resource:'资源'};const esc=v=>String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
function render(){const q=input.value.trim().toLowerCase(),terms=q.split(/\s+/).filter(Boolean),matches=entries.filter(e=>terms.every(t=>[e.title,e.description,e.kind,e.tags.join(' '),e.body].join(' ').toLowerCase().includes(t)));status.textContent=q?`找到 ${matches.length} 条内容`:`索引包含 ${entries.length} 条内容`;results.innerHTML=(q?matches:entries).map((e,i)=>`<article><b>${String(i+1).padStart(2,'0')}</b><div><span>${esc(kindLabels[e.kind]||e.kind)} / ${esc(e.pubDate.slice(0,10))}</span><h2><a href="${esc(e.url)}">${esc(e.title)}</a></h2><p>${esc(e.description)}</p></div></article>`).join('')||'<p class="empty">没有匹配内容，试试更短的关键词。</p>';}fetch('/search.json').then(r=>r.json()).then(data=>{entries=data;input.addEventListener('input',render);render()}).catch(()=>status.textContent='索引载入失败，请稍后重试。');
</script></BaseLayout>
<style>.search-box{padding:2rem 1.5rem;border-bottom:1px solid var(--line)}.search-box label{display:block;font-size:.72rem;color:var(--accent);text-transform:uppercase}.search-box input{width:100%;border:0;border-bottom:2px solid var(--ink);padding:1rem 0;background:transparent;font-size:clamp(1.5rem,4vw,3rem)}.status{font-size:.75rem;color:var(--muted)}.results article{display:grid;grid-template-columns:4rem 1fr;border-bottom:1px solid var(--line)}.results article>b{padding:1.5rem;color:var(--accent)}.results article>div{padding:1.5rem;border-left:1px solid var(--line)}.results span{font-size:.7rem;color:var(--muted)}.results h2{margin:.3rem 0;font-size:clamp(1.4rem,3vw,2.5rem);letter-spacing:-.04em}.results h2 a{text-decoration:none}.results p{margin:0;color:var(--muted)}</style>
