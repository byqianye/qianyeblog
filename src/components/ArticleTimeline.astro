---
import { formatDate, getReadingMinutes } from "../lib/content";
import type { CollectionEntry } from "astro:content";
import homeContent from "../data/home.json";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
const readingTemplate = homeContent.readingMinutesTemplate ?? "{minutes} 分钟读完";
const groups = posts.reduce((items: Map<string, CollectionEntry<"blog">[]>, post) => {
  const year = String(post.data.pubDate.getFullYear());
  items.set(year, [...(items.get(year) ?? []), post]);
  return items;
}, new Map<string, CollectionEntry<"blog">[]>());
---

<section class="article-timeline" aria-label="文章归档列表">
  {
    Array.from(groups.entries()).map(([year, yearPosts]) => (
      <div class="timeline-year">
        <h2>{year}</h2>
        <div class="timeline-items">
          {yearPosts.map((post) => (
            <article class="timeline-item">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <div class="timeline-content">
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <div class="article-meta">
                  {post.data.category && <span>{post.data.category}</span>}
                  <span>{getReadingMinutes(post.body, readingTemplate)}</span>
                </div>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.tags?.length > 0 && (
                  <div class="tag-row" aria-label="文章标签">
                    {post.data.tags.map((tag: string) => <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>)}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</section>
