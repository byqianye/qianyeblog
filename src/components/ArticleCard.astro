---
import { formatDate, getReadingMinutes } from "../lib/content";
import homeContent from "../data/home.json";

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  cover: string;
  body?: string;
  featured?: boolean;
}

const { href, title, description, pubDate, tags, cover, body = "", featured = false } = Astro.props;
const replaceTemplate = (template: string, values: Record<string, string | number>) =>
  Object.entries(values).reduce((text, [key, value]) => text.replaceAll(`{${key}}`, String(value)), template);
const readAriaLabel = replaceTemplate(homeContent.articleReadAriaTemplate ?? "阅读《{title}》", { title });
const tagAriaLabel = homeContent.articleTagsAriaLabel ?? "文章标签";
const readingTemplate = homeContent.readingMinutesTemplate ?? "{minutes} 分钟读完";
---

<article class:list={["article-card", { featured }]}>
  <a class="article-media" href={href} aria-label={readAriaLabel}>
    <img src={cover} alt="" loading={featured ? "eager" : "lazy"} />
  </a>
  <div class="article-content">
    <div class="article-meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span>{getReadingMinutes(body, readingTemplate)}</span>
    </div>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
    <div class="tag-row" aria-label={tagAriaLabel}>
      {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>)}
    </div>
  </div>
</article>
