---
interface Props { mode?: "active" | "ambient"; }
const { mode = "ambient" } = Astro.props;
---

<canvas class="particle-field" data-mode={mode} data-motion="static" data-pointer="idle" aria-hidden="true"></canvas>

<script>
  interface Particle {
    x: number;
    y: number;
    centerX: number;
    centerY: number;
    orbitX: number;
    orbitY: number;
    angle: number;
    angularSpeed: number;
    radius: number;
    phase: number;
    depth: number;
    color: string;
  }

  const canvas = document.querySelector<HTMLCanvasElement>(".particle-field");
  const context = canvas?.getContext("2d", { alpha: true });

  if (canvas && context) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const active = canvas.dataset.mode === "active";
    const pointer = { x: 0, y: 0, active: false };
    const camera = { x: 0, y: 0 };
    const rootStyles = getComputedStyle(document.documentElement);
    const colors = [rootStyles.getPropertyValue("--accent").trim(), rootStyles.getPropertyValue("--signal").trim()];
    let particles: Particle[] = [];
    let frame = 0;
    let width = 0;
    let height = 0;
    let previousTime = 0;
    let seed = 1;

    const random = (minimum: number, maximum: number) => {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      return minimum + (seed / 4294967296) * (maximum - minimum);
    };

    const createParticles = () => {
      seed = 0x51a7f13;
      const divisor = width < 720 ? 22000 : 15000;
      const limit = active ? (width < 720 ? 42 : 96) : (width < 720 ? 22 : 38);
      const count = Math.min(limit, Math.max(18, Math.floor((width * height) / divisor)));
      canvas.dataset.particles = String(count);
      particles = Array.from({ length: count }, (_, index) => {
        const orbitX = random(10, active ? Math.min(150, width * .18) : 52);
        return {
          x: 0,
          y: 0,
          centerX: random(-20, width + 20),
          centerY: random(-20, height + 20),
          orbitX,
          orbitY: orbitX * random(.25, .8),
          angle: random(0, Math.PI * 2),
          angularSpeed: random(-.0032, .0032),
          radius: random(.55, index % 11 === 0 ? 2.15 : 1.3),
          phase: random(0, Math.PI * 2),
          depth: .5,
          color: colors[index % colors.length]
        };
      });
    };

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.dataset.dpr = String(ratio);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      pointer.x = width / 2;
      pointer.y = height / 2;
      camera.x = 0;
      camera.y = 0;
      createParticles();
    };

    const draw = (time: number) => {
      const delta = previousTime ? Math.min(2, (time - previousTime) / 16.667) : 1;
      previousTime = time;
      context.clearRect(0, 0, width, height);
      context.globalCompositeOperation = "lighter";

      if (active && !reducedMotion.matches) {
        const targetX = pointer.active ? (pointer.x / width - .5) * 22 : 0;
        const targetY = pointer.active ? (pointer.y / height - .5) * 16 : 0;
        camera.x += (targetX - camera.x) * Math.min(1, .045 * delta);
        camera.y += (targetY - camera.y) * Math.min(1, .045 * delta);
      }

      particles.forEach((particle, index) => {
        if (active && !reducedMotion.matches) particle.angle += particle.angularSpeed * delta;
        particle.depth = .5 + Math.sin(particle.angle * .72 + particle.phase) * .34;
        const parallax = .35 + particle.depth;
        particle.x = particle.centerX + Math.cos(particle.angle) * particle.orbitX + camera.x * parallax;
        particle.y = particle.centerY + Math.sin(particle.angle) * particle.orbitY + camera.y * parallax;

        const pulse = .52 + Math.sin(time * .0012 + particle.phase) * .2 + particle.depth * .32;
        const displayRadius = particle.radius * (.68 + particle.depth * .72);
        context.beginPath();
        context.fillStyle = particle.color;
        context.globalAlpha = Math.max(.18, pulse);
        context.shadowColor = particle.color;
        context.shadowBlur = 7 + particle.depth * 7;
        context.arc(particle.x, particle.y, displayRadius, 0, Math.PI * 2);
        context.fill();

        for (let targetIndex = index + 1; targetIndex < particles.length; targetIndex += 1) {
          const target = particles[targetIndex];
          const dx = particle.x - target.x;
          const dy = particle.y - target.y;
          const distance = Math.hypot(dx, dy);
          if (distance < 86) {
            const pointerDistance = pointer.active ? Math.hypot((particle.x + target.x) / 2 - pointer.x, (particle.y + target.y) / 2 - pointer.y) : Infinity;
            const pointerEmphasis = Math.max(0, 1 - pointerDistance / 190);
            context.beginPath();
            context.globalAlpha = (1 - distance / 86) * (.08 + pointerEmphasis * .38);
            context.strokeStyle = particle.color;
            context.lineWidth = .55;
            context.moveTo(particle.x, particle.y);
            context.lineTo(target.x, target.y);
            context.stroke();
          }
        }
      });

      context.shadowBlur = 0;
      context.globalAlpha = 1;
      context.globalCompositeOperation = "source-over";
      if (active && !reducedMotion.matches && !document.hidden) frame = requestAnimationFrame(draw);
    };

    const start = () => {
      cancelAnimationFrame(frame);
      previousTime = 0;
      if (document.hidden) { canvas.dataset.motion = "paused"; return; }
      if (reducedMotion.matches || !active) { canvas.dataset.motion = "static"; draw(performance.now()); }
      else { canvas.dataset.motion = "running"; frame = requestAnimationFrame(draw); }
    };

    window.addEventListener("pointermove", (event) => {
      pointer.x = event.clientX;
      pointer.y = event.clientY;
      pointer.active = active;
      canvas.dataset.pointer = active ? "active" : "idle";
    }, { passive: true });
    document.documentElement.addEventListener("pointerleave", () => { pointer.active = false; canvas.dataset.pointer = "idle"; });
    window.addEventListener("resize", () => { resize(); start(); }, { passive: true });
    document.addEventListener("visibilitychange", start);
    reducedMotion.addEventListener("change", start);
    resize();
    start();
  }
</script>

<style>
  .particle-field { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: .78; }
  .particle-field[data-mode="ambient"] { opacity: .3; }
  @media (max-width: 720px) { .particle-field { opacity: .58; } }
  @media (prefers-reduced-motion: reduce) { .particle-field { opacity: .38; } }
  @media (forced-colors: active) { .particle-field { display: none; } }
</style>
