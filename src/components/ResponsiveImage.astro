---
import { getWebpSrcSet } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
}

const { src, alt, width, height, loading = "lazy", fetchpriority = "auto", sizes } = Astro.props;
const webpSrcSet = getWebpSrcSet(src, width);
---

<picture>
  {webpSrcSet && <source srcset={webpSrcSet} type="image/webp" {sizes} />}
  <img {src} {alt} {width} {height} {loading} {fetchpriority} {sizes} decoding="async" />
</picture>
