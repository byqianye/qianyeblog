---
import type { CollectionEntry } from "astro:content";

interface Props {
  previousPost?: CollectionEntry<"blog">;
  nextPost?: CollectionEntry<"blog">;
}

const { previousPost, nextPost } = Astro.props;
---

<nav class="post-navigation" aria-label="上一篇和下一篇文章">
  <div class="post-nav-item">
    <span>上一篇</span>
    {
      previousPost ? (
        <a href={`/blog/${previousPost.id}`}>{previousPost.data.title}</a>
      ) : (
        <p>已经是最早的一篇了。</p>
      )
    }
  </div>
  <div class="post-nav-item">
    <span>下一篇</span>
    {
      nextPost ? (
        <a href={`/blog/${nextPost.id}`}>{nextPost.data.title}</a>
      ) : (
        <p>已经是最新的一篇了。</p>
      )
    }
  </div>
</nav>
